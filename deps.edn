{:paths ["src" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.2"}
        cheshire/cheshire {:mvn/version "5.12.0"}
        metosin/malli {:mvn/version "0.15.0"}
        stencil/stencil {:mvn/version "0.5.0"}
        tech.unravel/litellm-clj {:git/url "https://github.com/unravel-team/litellm-clj"
                                  :git/sha "a1ee7d4900aeebe090dbac5bb4473ba11e6ab744"
                                  ;:mvn/version "0.3.0-alpha"
                                  }}

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {circleci/bond {:mvn/version "0.6.0"}
                      lambdaisland/kaocha {:mvn/version "1.91.1392"}}}
  
  :integration {:extra-paths ["test"]
                :extra-deps {circleci/bond {:mvn/version "0.6.0"}
                             lambdaisland/kaocha {:mvn/version "1.91.1392"}}
                :main-opts ["-m" "kaocha.runner" "--focus" ".*integration.*"]}
  
  :kaocha {:extra-paths ["test"]
           :extra-deps {circleci/bond {:mvn/version "0.6.0"}
                        lambdaisland/kaocha {:mvn/version "1.91.1392"}}
           :main-opts ["-m" "kaocha.runner"]}
  
  :lint {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2024.03.13"}}
         :main-opts ["-m" "clj-kondo.main"]}
  
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.9.6"}}
          :ns-default build}}}
